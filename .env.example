# ------------------------------------------------------------------
# Joy In Zoe Intercessory Ministries — Environment Configuration
# ------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# --- Application ---------------------------------------------------
APP_NAME="Joy In Zoe Intercessory Ministries"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logging -------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB via XAMPP) --------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joyinzoe
DB_USERNAME=root
DB_PASSWORD=

# --- Session -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Broadcast / Filesystem / Queue --------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ----------------------------------------------------------
# MAIL_MAILER=log is fine for local development (writes to log).
# For real delivery use, e.g.:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.yourprovider.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-smtp-username
#   MAIL_PASSWORD=your-smtp-password
#   MAIL_ENCRYPTION=tls
# Never hardcode SMTP credentials; they live only in .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@joyinzoe.org"
MAIL_FROM_NAME="${APP_NAME}"

# Email address used to receive ministry support/contact enquiries.
SUPPORT_EMAIL=support@joyinzoe.org

# --- Initial Administrator (used by AdminUserSeeder) ---------------
# The first administrator account is created ONLY from these values.
# The password is hashed using Laravel's default bcrypt hashing.
# Set a strong, unique password before running `php artisan db:seed`.
ADMIN_NAME="Joy In Zoe Administrator"
ADMIN_EMAIL=admin@joyinzoe.org
ADMIN_PASSWORD=

# --- YouTube -------------------------------------------------------
# The homepage "Watch & Pray" section shows your most recent uploads.
# To AUTO-fetch the latest videos from your channel:
#   YOUTUBE_CHANNEL_ID=<your channel id, e.g. UC...>
#   YOUTUBE_API_KEY=<YouTube Data API v3 key>
# The latest upload is embedded automatically and cached for a while.
# Alternatively (and without any API key) you can pin a single video:
#   YOUTUBE_VIDEO_ID=<video id, e.g. dQw4w9WgXcQ>
# If nothing is set, a "follow our channel" card is shown instead.
YOUTUBE_VIDEO_ID=3SFlhcB_W_s
YOUTUBE_API_KEY=AIzaSyAdaHLlpeoOeLY6eA7ksyuy-hq0_KqlDWE
YOUTUBE_CHANNEL_ID=UCodcl_8hOftRxs6EGRk_B-g

# --- Telegram ------------------------------------------------------
# Only needed if Telegram automation is enabled.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GROUP_INVITE_LINK=

# --- AWS (optional, only if using S3 for file storage) -------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
